node_modules/
dist/
man/
.tmp-*.mjs
*.tsbuildinfo
.mise.local.toml

# benchmark + spike outputs that are regenerated, not committed.
# Scratch state now lives under BENCH_WORK_DIR (default ~/.cache/git-why-bench/),
# outside any git worktree; bench/work/ is listed only to catch a stale checkout.
bench/work/
bench/raw/opencode-models-raw.txt
spike/out/*.log
.tmp/
*.tgz

# VitePress site build output and its separate dependency tree
site/node_modules/
site/.vitepress/cache/
site/.vitepress/dist/
site/public/install.sh

# never publish
.env
.env.*
**/auth.json

# Editor/agent state, machine-specific and not part of the project.
.antigravitycli/

# The embedder evaluation pool: 12k commit messages, regenerable in seconds
# from the pinned clones by `node bench/embedders/build-pool.mjs`. Committing
# 3 MB of other projects' commit text to carry a derived artefact is not worth
# it; the scores beside it are the result.
bench/results/embedders/pool.json
