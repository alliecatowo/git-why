 // Delivers webhook events to billing-provider.
-// Single attempt: see project history before changing this.
+//
+// Intermittent 502s were dropping events, but the earlier retry loop
+// (c4f366d) had to be reverted (1ff52f0): billing-provider had no
+// idempotency key on this endpoint, so every retried delivery was
+// processed as a separate charge (1,842 customers double-charged).
+//
+// The endpoint now accepts an Idempotency-Key header, so retries are
+// safe again: every attempt for a given event carries the same key and
+// billing-provider processes a given key only once. The key is derived
+// from event.id, the same identifier the delivery queue uses to
+// deduplicate, so a retry can never be charged twice.
 async function deliver(io, event) {
-  const res = await io.post('/webhooks/billing', event);
-  return res;
+  const idempotencyKey = String(event.id ?? event.event_id ?? JSON.stringify(event));
+  for (let attempt = 0; attempt < 5; attempt += 1) {
+    const res = await io.post('/webhooks/billing', event, {
+      headers: { 'Idempotency-Key': idempotencyKey },
+    });
+    if (res.status < 500) return res;
+    await io.sleep(2 ** attempt * 100);
+  }
+  return { status: 502 };
 }
 
 module.exports = { deliver };
