 // Delivers notifications to notify-service.
+//
+// notify-service can fail intermittently with 5xx responses (notably 502 Bad
+// Gateway) and transient network errors. Those failures are usually momentary,
+// so delivering once and giving up is what causes missed notifications.
+//
+// Retrying is safe here: notify-service deduplicates deliveries on the
+// `X-Event-Id` header, so re-sending the same event is idempotent and will not
+// create duplicates (see docs/notify.md). We therefore retry transient
+// failures with exponential backoff plus jitter, and give up after a bounded
+// number of attempts so an unhealthy service can't make us hammer it or hang
+// forever. Non-retryable client errors (e.g. 4xx) are surfaced immediately.
+
+const MAX_ATTEMPTS = 5;
+const BASE_DELAY_MS = 100;
+const MAX_DELAY_MS = 2000;
+const RETRYABLE_STATUSES = new Set([408, 425, 429]);
+
+function isRetryableStatus(status) {
+  if (typeof status !== 'number') return false;
+  return RETRYABLE_STATUSES.has(status) || (status >= 500 && status <= 599);
+}
+
+function statusFromError(err) {
+  if (!err) return undefined;
+  const response = err.response;
+  return (
+    (response && (response.status ?? response.statusCode)) ??
+    err.status ??
+    err.statusCode
+  );
+}
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+function backoffDelayMs(attempt) {
+  const exponential = Math.min(MAX_DELAY_MS, BASE_DELAY_MS * 2 ** (attempt - 1));
+  const jitter = Math.floor(Math.random() * BASE_DELAY_MS);
+  return exponential + jitter;
+}
+
 async function deliver(io, event) {
-  const res = await io.post('/notify', event);
-  return res;
+  let lastError;
+
+  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
+    try {
+      const res = await io.post('/notify', event);
+      const status = res && (res.status ?? res.statusCode);
+
+      // Some HTTP clients resolve instead of rejecting on 5xx. Retry those
+      // too, unless we're out of attempts (then return the last response for
+      // the caller to inspect).
+      if (!isRetryableStatus(status) || attempt === MAX_ATTEMPTS) {
+        return res;
+      }
+
+      lastError = new Error(`notify-service responded with ${status}`);
+      lastError.response = res;
+    } catch (err) {
+      lastError = err;
+      const status = statusFromError(err);
+
+      // No status means the request never completed (connection reset,
+      // timeout, DNS failure, ...). Those are retryable. HTTP statuses are
+      // retryable only when transient.
+      const retryable = status === undefined || isRetryableStatus(status);
+      if (!retryable || attempt === MAX_ATTEMPTS) {
+        throw err;
+      }
+    }
+
+    await sleep(backoffDelayMs(attempt));
+  }
+
+  throw lastError;
 }
 
 module.exports = { deliver };
