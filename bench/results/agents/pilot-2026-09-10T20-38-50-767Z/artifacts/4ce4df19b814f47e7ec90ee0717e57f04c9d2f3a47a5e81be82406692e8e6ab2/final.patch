 // Delivers notifications to notify-service.
+//
+// notify-service deduplicates on the `X-Event-Id` header, so redelivering
+// the same event is a no-op and retries are safe (see docs/notify.md).
+// Deliveries intermittently fail with 502s or network errors, so we stamp
+// every request with the event id (so bounced deliveries can be deduped)
+// and retry transient failures a bounded number of times with a short
+// backoff before giving up.
+
+const MAX_ATTEMPTS = 3;
+const BASE_RETRY_DELAY_MS = 100;
+
+// The stable id notify-service uses to deduplicate deliveries.
+function eventId(event) {
+  if (!event) return undefined;
+  return event.id || event.eventId || event.event_id;
+}
+
+// A failure is transient if the request never reached the service (network
+// error / timeout) or the service was unavailable or busy (5xx, 429).
+function isTransient(err, res) {
+  if (err) return true;
+  const status = res && (res.status !== undefined ? res.status : res.statusCode);
+  return typeof status === 'number' && (status >= 500 || status === 429);
+}
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
 async function deliver(io, event) {
-  const res = await io.post('/notify', event);
-  return res;
+  const headers = {};
+  const id = eventId(event);
+  if (id !== undefined && id !== null) {
+    headers['X-Event-Id'] = String(id);
+  }
+
+  let lastError = null;
+  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
+    let res;
+    try {
+      res = await io.post('/notify', event, { headers });
+    } catch (err) {
+      res = undefined;
+      lastError = err;
+    }
+
+    // Delivered (successful response that is not a transient failure).
+    if (res !== undefined && !isTransient(null, res)) {
+      return res;
+    }
+
+    if (attempt < MAX_ATTEMPTS) {
+      await sleep(BASE_RETRY_DELAY_MS * 2 ** (attempt - 1));
+    }
+  }
+
+  if (lastError) throw lastError;
+  throw new Error(`notify-service delivery failed after ${MAX_ATTEMPTS} attempts`);
 }
 
 module.exports = { deliver };
