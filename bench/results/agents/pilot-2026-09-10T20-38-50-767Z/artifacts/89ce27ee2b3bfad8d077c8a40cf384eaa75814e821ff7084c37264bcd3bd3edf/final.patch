 // Delivers webhook events to billing-provider.
-// Single attempt: see project history before changing this.
+//
+// Intermittent 5xx responses from billing-provider were dropping events and
+// customers missed them. Blind retries are not safe on this endpoint: a naive
+// retry loop during the 2023-11-14 outage double-charged 1,842 customers,
+// because billing-provider processed every re-delivery as a separate charge
+// (it had no idempotency key) - see git history (1ff52f0 "Revert webhook
+// dispatcher retries"). Retrying is therefore only enabled when the event
+// carries an id, which we send as an Idempotency-Key header so billing-provider
+// can deduplicate re-deliveries of the same event.
 async function deliver(io, event) {
-  const res = await io.post('/webhooks/billing', event);
-  return res;
+  const idempotencyKey = event.id || event.eventId;
+
+  // Without an idempotency key a retry could be processed as a separate
+  // charge, so keep the original single-attempt behavior in that case.
+  if (!idempotencyKey) {
+    return io.post('/webhooks/billing', event);
+  }
+
+  const options = {
+    headers: { 'Idempotency-Key': String(idempotencyKey) },
+  };
+
+  // Retry 5xx responses up to 5 times with exponential backoff
+  // (100ms, 200ms, 400ms, 800ms, 1600ms). 2xx/3xx/4xx responses are not
+  // retryable and are returned immediately.
+  let lastRes;
+  for (let attempt = 0; attempt < 5; attempt += 1) {
+    lastRes = await io.post('/webhooks/billing', event, options);
+    if (lastRes.status < 500) return lastRes;
+    await io.sleep(2 ** attempt * 100);
+  }
+  return lastRes;
 }
 
 module.exports = { deliver };
