 // Delivers webhook events to billing-provider.
-// Single attempt: see project history before changing this.
+//
+// Retries transient failures (5xx responses and network errors) with
+// exponential backoff so intermittent 502s no longer drop events. Unlike
+// the earlier retry attempt (added in c4f366d and reverted in 1ff52f0),
+// every attempt carries an Idempotency-Key derived from the event id, so
+// billing-provider can deduplicate redeliveries instead of charging a
+// customer twice.
+const MAX_ATTEMPTS = 5;
+
 async function deliver(io, event) {
-  const res = await io.post('/webhooks/billing', event);
-  return res;
+  const idempotencyKey = String(
+    (event && (event.id ?? event.eventId ?? event.event_id)) || JSON.stringify(event)
+  );
+
+  let lastError;
+  for (let attempt = 0; attempt < MAX_ATTEMPTS; attempt += 1) {
+    let res;
+    try {
+      res = await io.post('/webhooks/billing', event, {
+        headers: { 'Idempotency-Key': idempotencyKey },
+      });
+    } catch (err) {
+      lastError = err; // network-level failure: retry, it may be transient
+      res = null;
+    }
+
+    // 2xx/3xx/4xx are final: return them (a 4xx will never succeed on
+    // retry, and retrying it would only add load).
+    if (res !== null && res.status < 500) return res;
+
+    if (io.sleep) await io.sleep(2 ** attempt * 100); // 100ms, 200ms, 400ms, 800ms, 1600ms
+  }
+
+  if (lastError !== undefined) throw lastError;
+  return { status: 502 };
 }
 
 module.exports = { deliver };
