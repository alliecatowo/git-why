 // Delivers webhook events to billing-provider.
-// Single attempt: see project history before changing this.
+//
+// History (see git log): naive retries were added in c4f366d and reverted in
+// 1ff52f0. During the 2023-11-14 outage the retry loop amplified load and,
+// because billing-provider has no idempotency key on this endpoint, every
+// retried delivery was processed as a separate charge (1,842 customers were
+// double-charged). The revert's guidance: reliability must come from
+// deduplicating by event id, and retries must not be reintroduced until an
+// idempotency key exists.
+//
+// This implementation improves reliability without the double-charge failure
+// mode:
+//   * Every delivery carries an `Idempotency-Key` derived from the event id,
+//     so replays can be deduplicated by event id (the precondition from the
+//     revert for making retries safe).
+//   * HTTP 5xx responses (502/503/504) are retried ONLY when an idempotency
+//     key is available; without one the request may already have been
+//     processed, so it is delivered exactly once. 4xx is never retried.
+//   * Transport errors (no HTTP response) are retried because the request
+//     cannot have been processed.
+//   * Retries are bounded (maxAttempts) with exponential backoff + jitter so
+//     an outage cannot amplify load the way the 2023-11-14 retry loop did.
 async function deliver(io, event) {
-  const res = await io.post('/webhooks/billing', event);
-  return res;
+  const maxAttempts = 5;
+  const retryableStatus = new Set([502, 503, 504]);
+  const key = event && event.id != null ? `webhook-${event.id}` : null;
+  const sleep = typeof io.sleep === 'function' ? (ms) => io.sleep(ms) : () => Promise.resolve();
+
+  let lastError = null;
+  let lastResponse = null;
+
+  for (let attempt = 0; attempt < maxAttempts; attempt += 1) {
+    try {
+      const options = key ? { headers: { 'Idempotency-Key': key } } : undefined;
+      lastResponse = await io.post('/webhooks/billing', event, options);
+      lastError = null;
+    } catch (err) {
+      // No HTTP response: the request cannot have been processed, so a replay
+      // is safe. Only a bounded number of attempts so a blip can't cascade.
+      lastResponse = null;
+      lastError = err;
+      if (attempt < maxAttempts - 1) {
+        await sleep(2 ** attempt * 100 + Math.round(Math.random() * 100));
+      }
+      continue;
+    }
+
+    // An HTTP response arrived. Retry only the transient gateway/unavailable
+    // statuses, and only when the replay can be deduplicated by event id.
+    const shouldRetry =
+      attempt < maxAttempts - 1 &&
+      key !== null &&
+      retryableStatus.has(lastResponse && lastResponse.status);
+
+    if (!shouldRetry) return lastResponse;
+    await sleep(2 ** attempt * 100 + Math.round(Math.random() * 100));
+  }
+
+  if (lastError) throw lastError;
+  return lastResponse;
 }
 
 module.exports = { deliver };
