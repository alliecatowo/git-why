--- a/src/session.js
+++ b/src/session.js
@@ -1,6 +1,34 @@
-// Resolves a session. Uncached by design; see project history.
+// Resolves a session, memoizing results to keep /api/session fast under load.
+//
+// The first caching attempt (commit 48ee78f) used a process-global Map keyed
+// by session id alone and was reverted (commit 1a6c01e) because session ids
+// are only unique per tenant: on shared workers it leaked one tenant's session
+// to another. To avoid repeating that bug, this cache:
+//   - lives on the io instance rather than at module scope, so it is not
+//     process-global and is naturally scoped to the io/tenant lifetime, and
+//   - keys entries by (tenantId, sessionId) via per-tenant sub-maps, so
+//     colliding session ids from different tenants can never be mixed up.
+// The in-flight promise is cached as well, so concurrent requests for the same
+// session share a single loadSession call instead of stampeding the store.
 async function resolveSession(io, sessionId) {
-  return io.loadSession(sessionId);
+  const tenantId = io.tenantId;
+  const cache = io.resolveSessionCache ?? (io.resolveSessionCache = new Map());
+  let tenantCache = cache.get(tenantId);
+  if (!tenantCache) {
+    tenantCache = new Map();
+    cache.set(tenantId, tenantCache);
+  }
+  if (tenantCache.has(sessionId)) return tenantCache.get(sessionId);
+
+  const pending = Promise.resolve()
+    .then(() => io.loadSession(sessionId))
+    .catch((err) => {
+      // Do not cache failures; a transient error should not poison the cache.
+      tenantCache.delete(sessionId);
+      throw err;
+    });
+  tenantCache.set(sessionId, pending);
+  return pending;
 }
 
 module.exports = { resolveSession };
