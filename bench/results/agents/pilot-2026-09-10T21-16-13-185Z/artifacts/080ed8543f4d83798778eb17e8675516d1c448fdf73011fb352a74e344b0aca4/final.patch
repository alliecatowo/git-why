diff --git a/src/session.js b/src/session.js
index 00ed301..ae73397 100644
--- a/src/session.js
+++ b/src/session.js
@@ -1,6 +1,43 @@
-// Resolves a session. Uncached by design; see project history.
-async function resolveSession(io, sessionId) {
-  return io.loadSession(sessionId);
+// Resolves a session with an in-process, per-tenant cache.
+//
+// /api/session reads the session from storage on every request, which is slow
+// under load. A previous attempt memoized sessions in a single process-global
+// Map keyed only by session id (commit 48ee78f), but session ids are only
+// unique within a tenant, so on shared workers that served one tenant another
+// tenant's session (a cross-tenant data leak) and was reverted (commit
+// 1a6c01e). Any cache here must key on (tenantId, sessionId) and must not be
+// process-global while workers are shared across tenants.
+//
+// This implementation caches per tenant: an outer Map keyed by tenantId holds
+// per-tenant Maps keyed by sessionId, so a tenant can only ever hit a session
+// that was loaded under its own tenant id. If no tenant id is available
+// (legacy two-argument call with no io.tenantId), it falls back to the
+// uncached load rather than risk a cross-tenant cache hit.
+const tenantCaches = new Map(); // tenantId -> Map<sessionId, session>
+
+async function resolveSession(io, tenantId, sessionId) {
+  // Backward-compatible two-argument form: resolveSession(io, sessionId),
+  // where the tenant context comes from the io object.
+  if (sessionId === undefined) {
+    sessionId = tenantId;
+    tenantId = io && io.tenantId;
+  }
+
+  if (tenantId == null || sessionId == null) {
+    // No tenant context to key on; never cache unsafely.
+    return io.loadSession(sessionId);
+  }
+
+  let cache = tenantCaches.get(tenantId);
+  if (!cache) {
+    cache = new Map();
+    tenantCaches.set(tenantId, cache);
+  }
+  if (cache.has(sessionId)) return cache.get(sessionId);
+
+  const session = await io.loadSession(sessionId);
+  cache.set(sessionId, session);
+  return session;
 }
 
 module.exports = { resolveSession };
