+++ b/src/session.js
@@ -1,6 +1,75 @@
-// Resolves a session. Uncached by design; see project history.
+// Resolves a session.
+//
+// Sessions are read repeatedly on the request path (middleware, auth, then
+// handlers), so memoize them for the lifetime of the caller's request/tenant
+// context. This is intentionally *not* a process-global map: an earlier cache
+// here was reverted because a shared worker served one tenant another
+// tenant's session. Two rules keep this one safe (see project history):
+//
+//   1. The cache key is (tenantId, sessionId). Session ids are only unique
+//      per tenant, so a sessionId-only key can collide across tenants.
+//   2. The cache lives on / is scoped to the request/tenant context (`io`),
+//      so entries are never shared between contexts and are released with
+//      the context.
+//
+// Concurrent misses for the same key share one load, so a burst of lookups
+// for one session does not stampede the backend.
+
+const CACHE = Symbol('resolveSession.cache');
+const contextCaches = new WeakMap();
+
+function tenantIdOf(io) {
+  const tenant = io.tenant;
+  return (
+    io.tenantId ??
+    io.tenant_id ??
+    (typeof tenant === 'string' ? tenant : tenant && tenant.id) ??
+    io.ctx?.tenantId ??
+    io.context?.tenantId
+  );
+}
+
+function cacheFor(io) {
+  // Only objects/functions can carry a per-context cache.
+  if (io === null || (typeof io !== 'object' && typeof io !== 'function')) {
+    return new Map();
+  }
+
+  const existing = io[CACHE];
+  if (existing instanceof Map) return existing;
+
+  const cache = new Map();
+  try {
+    Object.defineProperty(io, CACHE, { value: cache, configurable: true });
+    return cache;
+  } catch {
+    // Frozen/non-extensible context: fall back to a WeakMap keyed by the
+    // context. Still scoped per context, never shared across tenants.
+    let fallback = contextCaches.get(io);
+    if (!fallback) {
+      fallback = new Map();
+      contextCaches.set(io, fallback);
+    }
+    return fallback;
+  }
+}
+
 async function resolveSession(io, sessionId) {
-  return io.loadSession(sessionId);
+  const cache = cacheFor(io);
+  const key = `${tenantIdOf(io) ?? ''}\u0000${sessionId}`;
+
+  if (cache.has(key)) return cache.get(key);
+
+  const pending = Promise.resolve()
+    .then(() => io.loadSession(sessionId))
+    .catch((error) => {
+      // Don't cache failures; let the next request retry.
+      if (cache.get(key) === pending) cache.delete(key);
+      throw error;
+    });
+
+  cache.set(key, pending);
+  return pending;
 }
 
 module.exports = { resolveSession };
