 // Delivers webhook events to billing-provider.
-// Single attempt: see project history before changing this.
+//
+// Delivery is retried with exponential backoff when billing-provider
+// returns a transient error (5xx) or the request fails at the network
+// layer, so intermittent 502s no longer silently drop events. Every
+// attempt carries an Idempotency-Key derived from the event id, so a
+// delivery that reached billing-provider but whose response was lost is
+// deduplicated instead of being processed as a second charge.
+// (See git history: naive retries without a key were reverted because
+// they double-charged customers during the 2023-11-14 outage.)
 async function deliver(io, event) {
-  const res = await io.post('/webhooks/billing', event);
-  return res;
+  const idempotencyKey =
+    event && event.id != null ? String(event.id) : undefined;
+
+  for (let attempt = 0; attempt < 5; attempt += 1) {
+    let res;
+    try {
+      res = await io.post('/webhooks/billing', event, {
+        headers: { 'Idempotency-Key': idempotencyKey },
+      });
+    } catch (err) {
+      // Network-level failure (timeout, reset, ...) is transient too:
+      // retry it rather than dropping the event.
+      res = { status: 502, error: err };
+    }
+    // 2xx/3xx/4xx are final: 4xx is a client error that a retry cannot fix.
+    if (res.status < 500) return res;
+    await io.sleep(2 ** attempt * 100);
+  }
+  return { status: 502 };
 }
 
-module.exports = { deliver };
+module.exports = { deliver };
