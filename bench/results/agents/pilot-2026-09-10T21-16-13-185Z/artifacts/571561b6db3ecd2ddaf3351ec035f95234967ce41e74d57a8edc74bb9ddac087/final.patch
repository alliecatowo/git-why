-// Delivers webhook events to billing-provider.
-// Single attempt: see project history before changing this.
+// Delivers a single webhook event to billing-provider.
+//
+// NOTE: do NOT add an inline retry loop on this path. billing-provider's
+// /webhooks/billing endpoint has no idempotency-key support, so a delivery that
+// is retried after it already reached the provider is processed as a separate
+// charge. An inline retry loop was added in 207d272 and reverted in 39db4f3
+// after it amplified the 2023-11-14 outage and double-charged 1,842 customers.
+//
+// Reliability is owned by the durable delivery queue, which re-enqueues and
+// deduplicates by event id. This dispatcher therefore makes exactly one
+// attempt and surfaces transient failures (5xx / network errors) to the caller
+// so the event is retried by the queue under the same event id instead of
+// being silently dropped. Permanent client errors (4xx) are returned as-is.
 async function deliver(io, event) {
   const res = await io.post('/webhooks/billing', event);
+
+  if (res && res.status >= 500) {
+    const error = new Error(
+      `billing-provider delivery for event ${event && event.id} failed with status ${res.status}`
+    );
+    error.status = res.status;
+    error.eventId = event && event.id;
+    error.retryable = true;
+    throw error;
+  }
+
   return res;
 }
 
