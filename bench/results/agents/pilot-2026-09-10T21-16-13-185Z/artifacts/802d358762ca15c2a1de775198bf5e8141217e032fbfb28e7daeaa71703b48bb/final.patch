 // Delivers notifications to notify-service.
-async function deliver(io, event) {
-  const res = await io.post('/notify', event);
-  return res;
+//
+// notify-service dedupes on the `X-Event-Id` header (see docs/notify.md), so
+// redelivering the same event is a no-op and retries are safe. To make
+// delivery reliable we therefore:
+//   1. Always send the event's id as `X-Event-Id` so the service can dedupe.
+//   2. Retry transient failures (network errors, 429, and 5xx such as the
+//      intermittent 502s) with exponential backoff + jitter instead of
+//      giving up on the first failed attempt.
+//   3. Do not retry client errors (4xx other than 429): those will not
+//      succeed on redelivery.
+
+const DEFAULT_MAX_ATTEMPTS = 5;
+const BASE_BACKOFF_MS = 100;
+const MAX_BACKOFF_MS = 5000;
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+// A 429 or 5xx indicates a transient problem on the service side (bad
+// gateway, overload, upstream hiccup) that a retry can overcome. 4xx client
+// errors are permanent and should not be retried.
+function isRetryableStatus(status) {
+  return status === 429 || (status >= 500 && status <= 599);
+}
+
+// Normalize the response object to a numeric HTTP status, if it has one.
+function statusOf(res) {
+  if (res && typeof res === 'object') {
+    if (typeof res.status === 'number') return res.status;
+    if (typeof res.statusCode === 'number') return res.statusCode;
+  }
+  return null;
+}
+
+// Exponential backoff with up to 25% jitter to avoid a thundering herd of
+// retries right after an outage.
+function backoffDelay(attempt) {
+  const exp = Math.min(MAX_BACKOFF_MS, BASE_BACKOFF_MS * 2 ** attempt);
+  return Math.round(exp * (0.75 + Math.random() * 0.25));
+}
+
+// Honor a numeric `Retry-After` header if the service asked us to wait.
+function retryAfterMs(res) {
+  if (!res || !res.headers) return null;
+  const header = res.headers['retry-after'];
+  if (header === undefined || header === null) return null;
+  const seconds = Number(header);
+  if (Number.isFinite(seconds) && seconds >= 0) return seconds * 1000;
+  return null;
+}
+
+async function deliver(io, event, options = {}) {
+  const maxAttempts = options.maxAttempts || DEFAULT_MAX_ATTEMPTS;
+  const eventId = (event && (event.id ?? event.eventId)) || '';
+  const headers = {
+    'X-Event-Id': String(eventId),
+    ...(options.headers || {}),
+  };
+
+  let lastError = null;
+
+  for (let attempt = 0; attempt < maxAttempts; attempt += 1) {
+    try {
+      const res = await io.post('/notify', event, { headers });
+      const status = statusOf(res);
+
+      // 2xx, or a response without a recognizable status: deliver as-is.
+      if (status === null || (status >= 200 && status < 300)) {
+        return res;
+      }
+
+      // Permanent failure (e.g. 4xx): retrying will not help.
+      if (!isRetryableStatus(status)) {
+        return res;
+      }
+
+      // Transient failure. Out of attempts? Surface the last response so the
+      // caller can see what happened (it can still inspect res.status).
+      if (attempt === maxAttempts - 1) {
+        return res;
+      }
+
+      lastError = new Error(`notify-service returned status ${status}`);
+      lastError.status = status;
+      lastError.response = res;
+
+      const waitMs = retryAfterMs(res) ?? backoffDelay(attempt);
+      await sleep(waitMs);
+    } catch (err) {
+      // Network-level failure (connection refused, timeout, DNS, ...).
+      lastError = err;
+      if (attempt === maxAttempts - 1) {
+        throw err;
+      }
+      await sleep(backoffDelay(attempt));
+    }
+  }
+
+  throw lastError;
 }
 
 module.exports = { deliver };
