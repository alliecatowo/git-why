 // Delivers notifications to notify-service.
+//
+// notify-service deduplicates on the X-Event-Id header (see docs/notify.md),
+// so redelivering the same event is a no-op. That makes retries safe, which we
+// rely on here: transient failures (network errors and 5xx responses such as
+// 502 Bad Gateway) are retried with exponential backoff so that intermittent
+// upstream outages no longer cause missed notifications.
+
+const MAX_ATTEMPTS = 5;
+const BASE_BACKOFF_MS = 100;
+const MAX_BACKOFF_MS = 5000;
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+// A transient failure is a thrown network-level error (connection reset,
+// timeout, DNS failure, ...) or a 5xx response (e.g. 502 Bad Gateway). 4xx
+// responses are permanent client errors and must not be retried.
+function isTransient(res) {
+  if (res instanceof Error) return true;
+  const status = res && res.status;
+  if (typeof status !== 'number') return true;
+  return status >= 500 && status < 600;
+}
+
+// Extract the event identifier used for server-side deduplication.
+function eventId(event) {
+  if (event && typeof event === 'object') {
+    if (event.id != null) return event.id;
+    if (event.eventId != null) return event.eventId;
+    if (event.event_id != null) return event.event_id;
+  }
+  return undefined;
+}
+
 async function deliver(io, event) {
-  const res = await io.post('/notify', event);
-  return res;
+  const id = eventId(event);
+  const options = id != null ? { headers: { 'X-Event-Id': String(id) } } : undefined;
+
+  let lastResult;
+  for (let attempt = 0; attempt < MAX_ATTEMPTS; attempt += 1) {
+    let res;
+    try {
+      res = await io.post('/notify', event, options);
+    } catch (err) {
+      res = err;
+    }
+
+    if (!isTransient(res)) {
+      return res;
+    }
+
+    lastResult = res;
+
+    if (attempt < MAX_ATTEMPTS - 1) {
+      // Exponential backoff: 100ms, 200ms, 400ms, 800ms, capped at 5s.
+      const backoff = Math.min(BASE_BACKOFF_MS * 2 ** attempt, MAX_BACKOFF_MS);
+      await sleep(backoff);
+    }
+  }
+
+  throw lastResult;
 }
 
 module.exports = { deliver };
