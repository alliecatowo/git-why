 // Delivers notifications to notify-service.
-async function deliver(io, event) {
-  const res = await io.post('/notify', event);
-  return res;
+//
+// notify-service deduplicates events on the `X-Event-Id` header, so redelivering
+// the same event is safe: a duplicate delivery is a no-op server-side
+// (see docs/notify.md). Because retries are safe, we make deliveries reliable by
+// retrying transient failures - the intermittent 502s (and other 5xx), 429 rate
+// limiting, and network-level errors - with bounded exponential backoff and
+// jitter. Permanent failures (4xx client errors) are never retried and are
+// surfaced to the caller immediately.
+
+const DEFAULT_MAX_ATTEMPTS = 3;
+const BASE_BACKOFF_MS = 100;
+const MAX_BACKOFF_MS = 5000;
+
+// Network-level errors that can be safely retried (the request may or may not
+// have reached notify-service; thanks to idempotency that is fine).
+const RETRYABLE_NETWORK_CODES = new Set([
+  'ECONNRESET',
+  'ECONNREFUSED',
+  'ECONNABORTED',
+  'ETIMEDOUT',
+  'EAI_AGAIN',
+  'EPIPE',
+  'ENOTFOUND',
+  'EHOSTUNREACH',
+  'ENETUNREACH',
+]);
+
+function getStatus(res) {
+  if (!res) return undefined;
+  return res.status !== undefined ? res.status : res.statusCode;
+}
+
+function isTransientStatus(status) {
+  // 5xx (including the intermittent 502s) and 429 (rate limited) are transient;
+  // 4xx client errors indicate a permanent problem and must not be retried.
+  return status === 429 || (status >= 500 && status <= 599);
+}
+
+function isNetworkError(err) {
+  if (!err) return false;
+  if (RETRYABLE_NETWORK_CODES.has(err.code)) return true;
+  return (
+    typeof err.message === 'string' &&
+    /(socket hang up|network error|fetch failed|temporarily unavailable|timed?\s?out|connection (reset|refused|closed))/i.test(
+      err.message
+    )
+  );
+}
+
+// Honour a Retry-After header when present (capped so a misconfigured value
+// cannot stall delivery forever).
+function retryAfterMs(res) {
+  if (!res || !res.headers) return undefined;
+  const raw = res.headers['retry-after'];
+  if (raw === undefined || raw === null) return undefined;
+  const seconds = Number(raw);
+  if (!Number.isNaN(seconds)) return Math.max(0, seconds * 1000);
+  const date = Date.parse(raw);
+  if (!Number.isNaN(date)) return Math.max(0, date - Date.now());
+  return undefined;
+}
+
+// Exponential backoff with jitter, capped to avoid unbounded waits. `attempt`
+// is 1-based; this computes the delay before the retry that follows `attempt`.
+function backoffMs(attempt, res) {
+  const serverHint = retryAfterMs(res);
+  if (serverHint !== undefined) return Math.min(serverHint, MAX_BACKOFF_MS);
+  const cap = Math.min(BASE_BACKOFF_MS * 2 ** (attempt - 1), MAX_BACKOFF_MS);
+  return Math.floor(cap / 2 + Math.random() * (cap / 2));
+}
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+async function deliver(io, event, options = {}) {
+  const maxAttempts =
+    options.maxAttempts !== undefined ? options.maxAttempts : DEFAULT_MAX_ATTEMPTS;
+
+  let lastError;
+  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
+    let res;
+    try {
+      res = await io.post('/notify', event);
+    } catch (err) {
+      lastError = err;
+      if (!isNetworkError(err) || attempt === maxAttempts) {
+        throw err;
+      }
+      await sleep(backoffMs(attempt));
+      continue;
+    }
+
+    const status = getStatus(res);
+    // Treat a missing status as a successful/unverifiable response (legacy
+    // behaviour) and 2xx as success.
+    if (status === undefined || (status >= 200 && status < 300)) {
+      return res;
+    }
+
+    // Permanent failure, or we have exhausted the retry budget: surface the
+    // last response to the caller exactly like the original code did.
+    if (!isTransientStatus(status) || attempt === maxAttempts) {
+      return res;
+    }
+
+    await sleep(backoffMs(attempt, res));
+  }
+
+  throw lastError || new Error('notify-service delivery failed');
 }
 
 module.exports = { deliver };
