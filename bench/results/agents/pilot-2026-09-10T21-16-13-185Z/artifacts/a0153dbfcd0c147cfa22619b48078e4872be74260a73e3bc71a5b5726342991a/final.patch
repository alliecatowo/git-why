 // Delivers notifications to notify-service.
+//
+// notify-service can intermittently return transient 5xx responses (e.g. 502
+// Bad Gateway) or the connection can drop mid-flight, so a single attempt is
+// not enough: those failures used to be lost and users missed notifications.
+// The service deduplicates on `X-Event-Id`, so retrying the same event is
+// safe. Therefore we retry transient failures (network errors and 5xx
+// responses) with exponential backoff plus jitter, and only give up after all
+// attempts are exhausted.
+
+const MAX_ATTEMPTS = 4; // 1 initial attempt + 3 retries
+const BASE_BACKOFF_MS = 100;
+const MAX_BACKOFF_MS = 5000;
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+// A failure is transient when the request never reached the service (thrown
+// network error or no response) or the service answered with a 5xx status
+// code indicating it was temporarily unable to fulfil the request. Other
+// non-2xx responses (e.g. 4xx client errors) are deterministic and must not be
+// retried.
+function isTransientFailure(res) {
+  if (!res) return true;
+  const status = typeof res.status === 'number' ? res.status : res.statusCode;
+  return typeof status !== 'number' || status >= 500;
+}
+
+// Exponential backoff with full jitter. Jitter prevents a thundering herd of
+// simultaneous retries when many deliveries fail at once during an outage.
+function backoffMs(attempt) {
+  const cap = Math.min(MAX_BACKOFF_MS, BASE_BACKOFF_MS * 2 ** attempt);
+  return Math.floor(Math.random() * cap);
+}
+
 async function deliver(io, event) {
-  const res = await io.post('/notify', event);
-  return res;
+  let lastFailure;
+
+  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt += 1) {
+    try {
+      const res = await io.post('/notify', event);
+      if (!isTransientFailure(res)) {
+        return res;
+      }
+      lastFailure = res;
+    } catch (err) {
+      lastFailure = err;
+    }
+
+    if (attempt < MAX_ATTEMPTS) {
+      await sleep(backoffMs(attempt));
+    }
+  }
+
+  if (lastFailure instanceof Error) {
+    throw lastFailure;
+  }
+  const status = lastFailure && (lastFailure.status || lastFailure.statusCode);
+  throw new Error(
+    `notify-service delivery failed after ${MAX_ATTEMPTS} attempts` +
+      (status ? ` (last status: ${status})` : '')
+  );
 }
 
 module.exports = { deliver };
