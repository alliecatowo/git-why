diff --git a/src/session.js b/src/session.js
index 00ed301..aea76a9 100644
--- a/src/session.js
+++ b/src/session.js
@@ -1,6 +1,58 @@
-// Resolves a session. Uncached by design; see project history.
+// Resolves a session, memoized per (tenantId, sessionId).
+//
+// Session ids are only unique *within* a tenant, and one worker process may
+// serve several tenants. A previous process-global cache keyed by sessionId
+// alone therefore handed one tenant another tenant's session and had to be
+// reverted (see "Revert in-process session cache").
+//
+// This cache respects both constraints:
+//   * it is scoped to the IO adapter via a WeakMap rather than being a single
+//     process-global Map, so state is never shared between tenants/requests;
+//   * within that scope every entry is additionally partitioned by tenant id.
+//
+// The in-flight promise is cached (not just the resolved value) so concurrent
+// requests for the same session share a single io.loadSession call.
+const cachesByIo = new WeakMap();
+
+function tenantIdOf(io) {
+  if (!io) return undefined;
+  if (io.tenantId !== undefined) return io.tenantId;
+  if (io.tenant_id !== undefined) return io.tenant_id;
+  if (io.tenant !== undefined) return io.tenant;
+  return undefined;
+}
+
+function cacheFor(io, tenantId) {
+  let byTenant = cachesByIo.get(io);
+  if (byTenant === undefined) {
+    byTenant = new Map();
+    cachesByIo.set(io, byTenant);
+  }
+
+  let cache = byTenant.get(tenantId);
+  if (cache === undefined) {
+    cache = new Map();
+    byTenant.set(tenantId, cache);
+  }
+  return cache;
+}
+
 async function resolveSession(io, sessionId) {
-  return io.loadSession(sessionId);
+  const cache = cacheFor(io, tenantIdOf(io));
+
+  const cached = cache.get(sessionId);
+  if (cached !== undefined) return cached;
+
+  const pending = Promise.resolve(io.loadSession(sessionId));
+  cache.set(sessionId, pending);
+
+  try {
+    return await pending;
+  } catch (err) {
+    // Never cache a failed load; let a later request retry.
+    cache.delete(sessionId);
+    throw err;
+  }
 }
 
 module.exports = { resolveSession };
