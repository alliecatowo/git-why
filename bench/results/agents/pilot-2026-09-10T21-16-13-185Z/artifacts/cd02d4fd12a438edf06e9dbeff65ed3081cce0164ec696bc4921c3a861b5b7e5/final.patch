-  return res;
+  if (res.status >= 200 && res.status < 300) {
+    return res;
+  }
+  const err = new Error(`billing webhook delivery failed with status ${res.status}`);
+  err.status = res.status;
+  if (event && event.id) {
+    err.eventId = event.id;
+  }
+  throw err;
 }
 
 module.exports = { deliver };
