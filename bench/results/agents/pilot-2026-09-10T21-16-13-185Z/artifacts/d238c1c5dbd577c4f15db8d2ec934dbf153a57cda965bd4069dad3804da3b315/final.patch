 // Delivers notifications to notify-service.
+//
+// notify-service deduplicates on `X-Event-Id` (see docs/notify.md), so
+// retrying the same notification is safe. Intermittent 502s and other
+// transient failures are retried with exponential backoff + jitter so
+// deliveries are not lost.
+
+const MAX_ATTEMPTS = 5;
+const BASE_DELAY_MS = 200;
+const MAX_DELAY_MS = 5000;
+
+// A failure is transient (and worth retrying) when the request never
+// produced a response (network error, socket hang-up, timeout) or when
+// the service returned a 5xx / 429 status. 4xx client errors are not
+// retried because they will keep failing identically.
+function isRetryable(res) {
+  if (!res) return true;
+  const status = res.status || res.statusCode;
+  if (!status) return true;
+  return status === 429 || status >= 500;
+}
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+// Exponential backoff with full jitter, capped, so a recovering service
+// is not hammered by a thundering herd of retries.
+function backoffMs(attempt) {
+  const cap = Math.min(MAX_DELAY_MS, BASE_DELAY_MS * Math.pow(2, attempt));
+  return Math.floor(Math.random() * cap);
+}
+
 async function deliver(io, event) {
-  const res = await io.post('/notify', event);
-  return res;
+  let last;
+  for (let attempt = 0; attempt < MAX_ATTEMPTS; attempt++) {
+    try {
+      const res = await io.post('/notify', event);
+      if (!isRetryable(res)) return res;
+      last = res;
+    } catch (err) {
+      last = err;
+    }
+    if (attempt < MAX_ATTEMPTS - 1) {
+      await sleep(backoffMs(attempt));
+    }
+  }
+  return last;
 }
 
 module.exports = { deliver };
