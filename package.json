{
  "name": "@alliecatowo/git-why",
  "version": "0.1.0",
  "description": "Semantic archaeology for Git. Find the history that explains the code.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://alliecatowo.github.io/git-why/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alliecatowo/git-why.git"
  },
  "bugs": {
    "url": "https://github.com/alliecatowo/git-why/issues"
  },
  "keywords": [
    "git",
    "cli",
    "search",
    "semantic-search",
    "retrieval",
    "history"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "git-why": "dist/cli/main.js",
    "git-why-mcp": "dist/mcp/main.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "schema/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "npm run build:test && node --test --test-concurrency=4 \".tmp/tsc-test/test/unit/**/*.test.js\"",
    "test:integration": "npm run build:test && node --test --test-concurrency=2 --test-timeout=600000 \".tmp/tsc-test/test/integration/**/*.test.js\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit",
    "build:test": "tsc -p tsconfig.test.json && node scripts/copy-test-assets.mjs",
    "site:install": "npm install --prefix site",
    "site:dev": "npm run --prefix site dev",
    "site:build": "npm run --prefix site build"
  },
  "dependencies": {
    "@zvec/zvec": "0.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "@eslint/js": "^9.17.0",
    "prettier": "^3.4.2"
  }
}
