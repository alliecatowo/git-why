{
  "name": "@alliecatowo/git-why",
  "version": "0.1.2",
  "description": "Semantic archaeology for Git. Find the history that explains the code.",
  "mcpName": "io.github.alliecatowo/git-why",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://alliecatowo.github.io/git-why/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alliecatowo/git-why.git"
  },
  "bugs": {
    "url": "https://github.com/alliecatowo/git-why/issues"
  },
  "keywords": [
    "git",
    "cli",
    "search",
    "semantic-search",
    "retrieval",
    "history"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "git-why": "dist/cli/main.js",
    "git-why-mcp": "dist/mcp/main.js"
  },
  "man": [
    "man/git-why.1"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "schema/",
    "man/",
    "completions/",
    "plugins/",
    "opencode/"
  ],
  "scripts": {
    "build": "node node_modules/typescript-7/bin/tsc -p tsconfig.build.json && node scripts/postbuild.mjs && node scripts/gen-man.mjs",
    "prepublishOnly": "npm run check",
    "typecheck": "node node_modules/typescript-7/bin/tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "npm run build:test && node --test --test-concurrency=4 \".tmp/tsc-test/test/unit/**/*.test.js\"",
    "test:integration": "npm run build:test && node --test --test-concurrency=2 --test-timeout=600000 \".tmp/tsc-test/test/integration/**/*.test.js\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run bench:freeze && npm run verify:plugins && npm run test:unit && npm run test:bench",
    "build:test": "node node_modules/typescript-7/bin/tsc -p tsconfig.test.json && node scripts/copy-test-assets.mjs",
    "test:bench": "node --test bench/agents/*.test.mjs",
    "site:install": "npm install --prefix site",
    "site:dev": "npm run --prefix site dev",
    "site:build": "npm run --prefix site build",
    "bench:freeze": "node bench/freeze-protocol.mjs",
    "bench:corpus": "node bench/corpus/baselines.mjs --cases bench/corpus/cases.json",
    "verify:plugins": "node scripts/verify-plugins.mjs"
  },
  "dependencies": {
    "@zvec/zvec": "0.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.0",
    "@eslint/js": "^10.0.1",
    "prettier": "^3.9.9",
    "typescript-7": "npm:typescript@^7.0.2"
  }
}
