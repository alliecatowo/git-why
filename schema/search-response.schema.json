{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-why.dev/schema/search-response.schema.json",
  "title": "Git Why search response envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "query",
    "mode",
    "sort",
    "results",
    "warnings",
    "outputTruncated",
    "candidateLimitReached",
    "coreQuery",
    "temporal",
    "answer",
    "timeline",
    "owners"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "query": {
      "type": "string"
    },
    "mode": {
      "enum": ["hybrid", "text", "semantic"]
    },
    "snapshot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["scope", "fingerprint", "indexedAt", "freshness", "coverage", "generation"],
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "branches-remotes-tags-worktree-heads"
            },
            "fingerprint": {
              "type": "string"
            },
            "indexedAt": {
              "type": ["string", "null"]
            },
            "freshness": {
              "enum": ["current", "stale", "unknown"]
            },
            "coverage": {
              "enum": ["complete_for_policy", "partial", "unknown"]
            },
            "generation": {
              "type": "string"
            }
          }
        }
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sha",
          "subject",
          "author",
          "authorTime",
          "committerTime",
          "parents",
          "messageExcerpt",
          "rankScore",
          "matchedBy",
          "evidence",
          "scores",
          "linkDistance"
        ],
        "additionalProperties": false,
        "properties": {
          "sha": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "author": {
            "type": "object",
            "required": ["name", "email"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            }
          },
          "authorTime": {
            "type": "number"
          },
          "committerTime": {
            "type": "number"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "messageExcerpt": {
            "type": "string"
          },
          "rankScore": {
            "type": "number"
          },
          "matchedBy": {
            "type": "array",
            "items": {
              "enum": ["text", "semantic", "linked"]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "recordId",
                "kind",
                "path",
                "oldPath",
                "changeType",
                "oldStart",
                "oldCount",
                "newStart",
                "newCount",
                "excerpt",
                "truncated",
                "omissionReasons"
              ],
              "additionalProperties": false,
              "properties": {
                "recordId": {
                  "type": "string"
                },
                "kind": {
                  "enum": ["hunk", "file_change"]
                },
                "path": {
                  "type": "string"
                },
                "pathBytesBase64": {
                  "type": "string"
                },
                "oldPath": {
                  "type": ["string", "null"]
                },
                "oldPathBytesBase64": {
                  "type": "string"
                },
                "changeType": {
                  "enum": ["A", "C", "D", "M", "R", "T", "U", "X"]
                },
                "oldStart": {
                  "type": ["number", "null"]
                },
                "oldCount": {
                  "type": ["number", "null"]
                },
                "newStart": {
                  "type": ["number", "null"]
                },
                "newCount": {
                  "type": ["number", "null"]
                },
                "excerpt": {
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                },
                "omissionReasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fused", "temporal", "final"],
            "properties": {
              "fused": {
                "type": "number"
              },
              "temporal": {
                "type": "number"
              },
              "final": {
                "type": "number"
              }
            }
          },
          "linkDistance": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputTruncated": {
      "type": "boolean"
    },
    "candidateLimitReached": {
      "type": "boolean"
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "hint"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": ["string", "null"]
        }
      }
    },
    "sort": {
      "type": "string",
      "enum": ["relevance", "newest", "oldest"],
      "description": "Deterministic ordering applied to the selected commits. Never changes which commits are returned."
    },
    "coreQuery": {
      "type": "string"
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "confidence", "anchor", "anchorEnd", "w"],
      "properties": {
        "intent": {
          "enum": [
            "none",
            "first",
            "last",
            "removed",
            "changed_when",
            "before",
            "after",
            "between",
            "around",
            "timeline"
          ]
        },
        "confidence": {
          "enum": ["explicit", "inferred"]
        },
        "anchor": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind", "raw", "sha", "epochSeconds"],
          "properties": {
            "kind": {
              "enum": ["date", "tag", "sha", "query"]
            },
            "raw": {
              "type": "string"
            },
            "sha": {
              "type": ["string", "null"]
            },
            "epochSeconds": {
              "type": ["number", "null"]
            }
          }
        },
        "anchorEnd": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind", "raw", "sha", "epochSeconds"],
          "properties": {
            "kind": {
              "enum": ["date", "tag", "sha", "query"]
            },
            "raw": {
              "type": "string"
            },
            "sha": {
              "type": ["string", "null"]
            },
            "epochSeconds": {
              "type": ["number", "null"]
            }
          }
        },
        "w": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "answer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sha", "kind", "subject", "committerTime", "viaToken", "viaPath", "confidence"],
      "properties": {
        "sha": {
          "type": "string"
        },
        "kind": {
          "enum": ["introduced", "last_modified", "removed"]
        },
        "subject": {
          "type": ["string", "null"]
        },
        "committerTime": {
          "type": ["number", "null"]
        },
        "viaToken": {
          "type": ["string", "null"]
        },
        "viaPath": {
          "type": ["string", "null"]
        },
        "confidence": {
          "enum": ["explicit", "inferred"]
        }
      }
    },
    "timeline": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "kind", "committerTime", "subject", "evidence"],
        "properties": {
          "sha": {
            "type": "string"
          },
          "kind": {
            "enum": ["introduced", "modified", "removed"]
          },
          "committerTime": {
            "type": "number"
          },
          "subject": {
            "type": "string"
          },
          "evidence": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "recordId",
                  "kind",
                  "path",
                  "oldPath",
                  "changeType",
                  "oldStart",
                  "oldCount",
                  "newStart",
                  "newCount",
                  "excerpt",
                  "truncated",
                  "omissionReasons"
                ],
                "additionalProperties": false,
                "properties": {
                  "recordId": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": ["hunk", "file_change"]
                  },
                  "path": {
                    "type": "string"
                  },
                  "pathBytesBase64": {
                    "type": "string"
                  },
                  "oldPath": {
                    "type": ["string", "null"]
                  },
                  "oldPathBytesBase64": {
                    "type": "string"
                  },
                  "changeType": {
                    "enum": ["A", "C", "D", "M", "R", "T", "U", "X"]
                  },
                  "oldStart": {
                    "type": ["number", "null"]
                  },
                  "oldCount": {
                    "type": ["number", "null"]
                  },
                  "newStart": {
                    "type": ["number", "null"]
                  },
                  "newCount": {
                    "type": ["number", "null"]
                  },
                  "excerpt": {
                    "type": "string"
                  },
                  "truncated": {
                    "type": "boolean"
                  },
                  "omissionReasons": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "owners": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "email", "weight", "commits", "firstTime", "lastTime", "topCommits"],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "commits": {
            "type": "number"
          },
          "firstTime": {
            "type": "number"
          },
          "lastTime": {
            "type": "number"
          },
          "topCommits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sha", "subject", "committerTime"],
              "properties": {
                "sha": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "committerTime": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
