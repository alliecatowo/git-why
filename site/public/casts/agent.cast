[0.160, "o", "\u001b[0m$ \u001b[0mgit show b1077f05 --stat\r\ncommit b1077f05f85450cf53108714973bf7c8d9e3c35d\r\nAuthor: Colin McDonnell <3084745+colinhacks@users.noreply.github.com>\r\nDate:   Sun Aug 16 18:29:41 2026 -0700\r\n\r\n    perf(memory): install derived internals on a per-constructor prototype (#6415)\r\n    \r\n    Moves lazily-derived `_zod` internals (`values`, `pattern`, `optin`, `optout`, `propValues`) onto a per-constructor prototype instead of installing an accessor on every instance.\r\n    \r\n    Wrapper schemas shrink the most: `.nullable()`/`.readonly()` 2.4 KB to 665 B, `.optional()` 1.9 KB to 694 B. Construction of `.optional()` is ~1.96x faster; parse is unchanged. Costs +77 B classic and +13 B mini gzipped.\r\n\r\n packages/zod/src/v4/classic/tests/lazy.test.ts |  10 +++\r\n packages/zod/src/v4/core/core.ts               |  17 ++--\r\n packages/zod/src/v4/core/schemas.ts            | 109 +++++++++++++------------\r\n packages/zod/src/v4/core/util.ts               |  27 ++++++\r\n 4 files changed, 106 insertions(+), 57 deletions(-)\r\n\u001b["]
[0.000, "o", "0m\r\n"]
[5.170, "o", "\u001b[0m$ \u001b[0mgit show 3063993a -- packages/zod/src/v4/core/core.ts | head -120\r\ncommit 3063993a3317ac8af7a244691b837fce3e53aa96\r\nAuthor: Chris Cook <chris.zirkel@gmail.com>\r\nDate:   Thu Aug 13 07:48:45 2026 +0200\r\n\r\n    perf(v4): cut per-schema memory ~90% by moving methods to the prototype (#6318)\r\n    \r\n    Schema instances carried their methods as own properties, which put them past the point where V8 stops using inline slots for property storage. Moving those methods to the prototype — where they materialize per instance on first read — cuts a schema's retained size by roughly 90% and makes construction several times faster.\r\n    \r\n    - `z.string()` 7709 → 816 bytes retained; a 10-key object 83928 → 12171; `zod/mini` `z.string()` 2528 → 593\r\n    - a 500-schema API catalogue holds 62.7 MB instead of 198.0 MB\r\n    - construction is 45–83% faster; parse throughput is unchanged\r\n    - bundle grows by a fixed ~150–200 B gzipped (+1% classic, +5% mini), the one axis that regresses\r\n    \r\n    Detacha"]
[0.000, "o", "bility is preserved — the getters bind on first access and cache, so `const { parse } = schema` and `arr.map(schema.parse)` still work — and descriptor attributes, enumerability and function-identity aliases were diffed against `main` across every schema type to keep the observable surface intact.\r\n    \r\n    Original work and the core insight by @zirkelc.\r\n\r\ndiff --git a/packages/zod/src/v4/core/core.ts b/packages/zod/src/v4/core/core.ts\r\nindex 3377ed0b..1d0f267d 100644\r\n--- a/packages/zod/src/v4/core/core.ts\r\n+++ b/packages/zod/src/v4/core/core.ts\r\n@@ -14,6 +14,10 @@ export const NEVER: never = /*@__PURE__*/ Object.freeze({\r\n   status: \"aborted\",\r\n }) as never;\r\n \r\n+/* Shared descriptor for installing `_zod`; defineProperty reads it\r\n+ * synchronously, so reusing one object avoids a per-instance allocation. */\r\n+const _zodDesc: PropertyDescriptor = { value: undefined, enumerable: false };\r\n+\r\n export /*@__NO_SIDE_EFFECTS__*/ function $constructor<T extends ZodTrait, D = T[\"_zod\"][\"def\"]>(\r\n   name: strin"]
[0.000, "o", "g,\r\n   initializer: (inst: T, def: D) => void,\r\n@@ -21,14 +25,18 @@ export /*@__NO_SIDE_EFFECTS__*/ function $constructor<T extends ZodTrait, D = T[\r\n ): $constructor<T, D> {\r\n   function init(inst: T, def: D) {\r\n     if (!inst._zod) {\r\n-      Object.defineProperty(inst, \"_zod\", {\r\n-        value: {\r\n-          def,\r\n-          constr: _,\r\n-          traits: new Set(),\r\n-        },\r\n-        enumerable: false,\r\n-      });\r\n+      _zodDesc.value = {\r\n+        def,\r\n+        constr: _,\r\n+        traits: new Set(),\r\n+      };\r\n+      try {\r\n+        Object.defineProperty(inst, \"_zod\", _zodDesc);\r\n+      } finally {\r\n+        // Cleared even on throw, so the shared descriptor never leaks one\r\n+        // instance's internals into the next.\r\n+        _zodDesc.value = undefined;\r\n+      }\r\n     }\r\n \r\n     if (inst._zod.traits.has(name)) {\r\n@@ -39,11 +47,11 @@ export /*@__NO_SIDE_EFFECTS__*/ function $constructor<T extends ZodTrait, D = T[\r\n \r\n     initializer(inst, def);\r\n \r\n-    // support prototype modifications\r"]
[0.000, "o", "\r\n+    // support prototype modifications; for-in avoids the array\r\n+    // allocation of Object.keys on the (usually empty) prototype\r\n     const proto = _.prototype;\r\n-    const keys = Object.keys(proto);\r\n-    for (let i = 0; i < keys.length; i++) {\r\n-      const k = keys[i]!;\r\n+    for (const k in proto) {\r\n+      if (!Object.prototype.hasOwnProperty.call(proto, k)) continue;\r\n       if (!(k in inst)) {\r\n         (inst as any)[k] = proto[k].bind(inst);\r\n       }\r\n@@ -58,9 +66,14 @@ export /*@__NO_SIDE_EFFECTS__*/ function $constructor<T extends ZodTrait, D = T[\r\n   function _(this: any, def: D) {\r\n     const inst = params?.Parent ? new Definition() : this;\r\n     init(inst, def);\r\n-    inst._zod.deferred ??= [];\r\n-    for (const fn of inst._zod.deferred) {\r\n-      fn();\r\n+    const deferred = inst._zod.deferred;\r\n+    if (deferred) {\r\n+      for (const fn of deferred) {\r\n+        fn();\r\n+      }\r\n+      // Released: initializers run once, and the list would otherwise be\r\n+      // retained for the schema's"]
