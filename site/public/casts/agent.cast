[3.381, "o", "\u001b[0m$ \u001b[0mgit show 3063993 --stat\r\ncommit 3063993a3317ac8af7a244691b837fce3e53aa96\r\nAuthor: Chris Cook <chris.zirkel@gmail.com>\r\nDate:   Thu Aug 13 07:48:45 2026 +0200\r\n\r\n    perf(v4): cut per-schema memory ~90% by moving methods to the prototype (#6318)\r\n    \r\n    Schema instances carried their methods as own properties, which put them past the point where V8 stops using inline slots for property storage. Moving those methods to the prototype — where they materialize per instance on first read — cuts a schema's retained size by roughly 90% and makes construction several times faster.\r\n    \r\n    - `z.string()` 7709 → 816 bytes retained; a 10-key object 83928 → 12171; `zod/mini` `z.string()` 2528 → 593\r\n    - a 500-schema API catalogue holds 62.7 MB instead of 198.0 MB\r\n    - construction is 45–83% faster; parse throughput is unchanged\r\n    - bundle grows by a fixed ~150–200 B gzipped (+1% classic, +5% mini), the one axis that regresses\r\n    \r\n    Detachability is preserved — the getters bind o"]
[0.000, "o", "n first access and cache, so `const { parse } = schema` and `arr.map(schema.parse)` still work — and descriptor attributes, enumerability and function-identity aliases were diffed against `main` across every schema type to keep the observable surface intact.\r\n    \r\n    Original work and the core insight by @zirkelc.\r\n\r\n AGENTS.md                                          |  36 +-\r\n packages/bench/memory/breakdown.ts                 |  36 ++\r\n packages/bench/memory/calibrate.ts                 |  38 ++\r\n packages/bench/memory/dict-mode.ts                 |  77 ++++\r\n packages/bench/memory/harness.ts                   |  83 +++++\r\n packages/bench/memory/leaks.ts                     | 145 ++++++++\r\n packages/bench/memory/own-props.ts                 |  49 +++\r\n packages/bench/memory/prop-arrays.ts               |  62 ++++\r\n packages/bench/memory/prop-slack.ts                |  45 +++\r\n packages/bench/memory/realworld.ts                 |  76 ++++\r\n packages/bench/memory/retainers.ts                 | 122 ++++++"]
[0.000, "o", "+\r\n packages/bench/memory/schema-footprint.ts          |  79 ++++\r\n packages/bench/memory/snapshot.ts                  | 133 +++++++\r\n packages/bench/memory/survey.ts                    |  80 +++++\r\n packages/bench/memory/throughput.ts                |  79 ++++\r\n packages/zod/src/v4/classic/schemas.ts             | 399 ++++++++++++---------\r\n .../v4/classic/tests/instance-footprint.test.ts    | 112 ++++++\r\n packages/zod/src/v4/core/core.ts                   |  43 ++-\r\n packages/zod/src/v4/core/schemas.ts                |  37 +-\r\n packages/zod/src/v4/core/util.ts                   |  71 ++++\r\n packages/zod/src/v4/mini/schemas.ts                |  63 ++--\r\n 21 files changed, 1649 insertions(+), 216 deletions(-)"]
